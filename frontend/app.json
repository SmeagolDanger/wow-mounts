{
  "expo": {
    "name": "WoW Mount Tracker",
    "slug": "wow-mount-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "wowmounts",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#08090D",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wowmounts.tracker",
      "backgroundColor": "#08090D"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08090D"
      },
      "package": "com.wowmounts.tracker"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
