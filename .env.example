# Battle.net API credentials
# Create at https://develop.battle.net/access/clients
BNET_CLIENT_ID=your_client_id_here
BNET_CLIENT_SECRET=your_client_secret_here
BNET_REGION=us
BNET_REDIRECT_URI=http://localhost:8000/api/auth/bnet/callback

# App security
SECRET_KEY=generate-a-real-secret-key

# CORS (comma-separated origins)
CORS_ORIGINS=*
