# .env.prod — Production environment variables
# Copy to .env.prod and fill in all values before deploying.
# NEVER commit this file to git.

# ── Database ─────────────────────────────────────────────────────────
POSTGRES_DB=wowmounts
POSTGRES_USER=wowmounts
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_REAL_PASSWORD

# ── Battle.net API ───────────────────────────────────────────────────
# Create at https://develop.battle.net/access/clients
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
BNET_REGION=us
BNET_REDIRECT_URI=https://your-domain.com/api/auth/bnet/callback

# ── App Security ─────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be at least 32 characters. App will refuse to start without it.
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET

# Comma-separated allowed origins (your app's domain). Do NOT use * in prod.
CORS_ORIGINS=https://your-domain.com

# Requests per minute per IP (default 60)
RATE_LIMIT_PER_MINUTE=60
